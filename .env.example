# Variables de fleet-trip-events-service con valores de QA LOCAL (no son secretos reales).
# Uso: cp .env.example .env   (el .env nunca se sube a git). En PROD los secretos viven solo en el servidor.

# --- Servicio ---
SERVER_PORT=18005

# --- PostgreSQL propia de fleet (en Docker el compose cambia host/puerto a fleet-db:5432) ---
DB_HOST=localhost
DB_PORT=18105
DB_NAME=tripbus_fleet
DB_USERNAME=fleet
DB_PASSWORD=fleet_qa_pw

# --- Redis compartido, con contraseña (en Docker: redis:6379) ---
REDIS_HOST=localhost
REDIS_PORT=18100
REDIS_PASSWORD=tripbus_redis_qa_pw

# --- Token entre servicios (/internal/**) ---
INTERNAL_API_TOKEN=tripbus_internal_qa_token

# --- Otros servicios (en Docker el compose los cambia a host.docker.internal) ---
IDENTITY_JWKS_URI=http://localhost:18001/.well-known/jwks.json
CATALOG_URL=http://localhost:18002

# --- Simulador GPS del MVP (mueve los buses de los viajes en curso; en PROD va apagado) ---
SIMULATOR_ENABLED=true
