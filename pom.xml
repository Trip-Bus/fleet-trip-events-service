<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.tripbus</groupId>
    <artifactId>fleet-trip-events-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>fleet-trip-events-service</name>
    <description>Flota y eventos de viaje de TripBus: posiciones GPS, novedades del viaje y simulador GPS del MVP</description>

    <properties>
        <java.version>21</java.version>

        <!-- Parches de seguridad (Trivy) más nuevos que los que gestiona Boot 3.5.16, dentro de las
             mismas líneas menores. Quitarlos cuando una Boot 3.5.x posterior ya los traiga. -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <netty.version>4.1.137.Final</netty.version>
        <tomcat.version>10.1.60</tomcat.version>
        <postgresql.version>42.7.12</postgresql.version>

        <springdoc.version>2.8.17</springdoc.version>
        <logstash-logback.version>8.0</logstash-logback.version>
        <jacoco.version>0.8.12</jacoco.version>
        <wiremock.version>3.13.1</wiremock.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

        <!-- Mínimos de cobertura total que exige jacoco:check (ver jacoco-maven-plugin).
             La cobertura nunca puede bajar: si agregas pruebas, sube el mínimo.
             Medición del 2026-10-29 (US-178; JVM en UTC como el CI): líneas 89,4 %, ramas 86,9 %.
             Mínimos: líneas 0.85; ramas 0.85. -->
        <jacoco.minimo.lineas>0.85</jacoco.minimo.lineas>
        <jacoco.minimo.ramas>0.85</jacoco.minimo.ramas>

        <!-- SonarQube Cloud: el análisis lo lanza el CI solo en develop (push y PR con base develop)
             cuando existe el secreto SONAR_TOKEN. El plan Free analiza una única rama. -->
        <sonar.organization>trip-bus</sonar.organization>
        <sonar.projectKey>Trip-Bus_fleet-trip-events-service</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Fuera de la cobertura solo lo que no tiene lógica que probar (se sigue analizando como código):
             arranque de Spring, records de entrada/salida sin métodos (web/dto), entidades JPA de solo
             constructor/getters y la definición del documento OpenAPI. Se quedan DENTRO porque tienen
             lógica: domain/FleetItinerary (cancelar, avanzarSimulacion), domain/RouteStop (Key.equals/
             hashCode) y config/FleetProperties (valores por defecto). MISMA lista en <excludes> de
             jacoco-maven-plugin (formato .class). -->
        <sonar.coverage.exclusions>
            **/FleetApplication.java,
            **/web/dto/ItineraryTracking.java,
            **/web/dto/PositionRequest.java,
            **/web/dto/PositionResponse.java,
            **/web/dto/StopView.java,
            **/web/dto/TripEventRequest.java,
            **/web/dto/TripEventResponse.java,
            **/web/dto/AssignDriverRequest.java,
            **/web/dto/DriverAssignmentResponse.java,
            **/web/dto/DriverTripView.java,
            **/web/dto/DriverLocationRequest.java,
            **/web/dto/LocationResult.java,
            **/web/dto/BatchLocationResponse.java,
            **/web/dto/TrackingStatusResponse.java,
            **/web/dto/StartTripRequest.java,
            **/web/dto/TripProgressResponse.java,
            **/web/dto/SosRequest.java,
            **/web/dto/ResolveAlertRequest.java,
            **/web/dto/TripAlertResponse.java,
            **/web/dto/EtaView.java,
            **/web/dto/FleetLiveResponse.java,
            **/domain/BusPosition.java,
            **/domain/OutboxMessage.java,
            **/domain/TripEvent.java,
            **/common/events/ProcessedEvent.java,
            **/config/OpenApiConfig.java
        </sonar.coverage.exclusions>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Swagger UI / OpenAPI (solo IDE y QA; apagado en application-prod.yml). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Logs en JSON en PROD (logback-spring.xml). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas de integración contra PostgreSQL y Redis reales (FleetIT, Testcontainers). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Identity simulado por HTTP en DriverIT (GET /internal/users/{id}). -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Versión fija del scanner que invoca el CI (mvn ... sonar-maven-plugin:sonar). -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- META-INF/build-info.properties: versión y fecha en /actuator/info. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Unitarias (*Test, *Tests) e integración (*IT, Testcontainers: requiere Docker). -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Cobertura: target/site/jacoco/index.html (y jacoco.xml para Sonar).
                 Además jacoco:check (fase verify) corre en TODAS las ramas, también en main donde no
                 corre Sonar: rompe el build si la cobertura total baja de jacoco.minimo.lineas/ramas.
                 La cobertura nunca puede bajar: si agregas pruebas, sube el mínimo. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!-- Mismas exclusiones que sonar.coverage.exclusions, para que el % coincida. -->
                    <excludes>
                        <exclude>**/FleetApplication.class</exclude>
                        <exclude>**/web/dto/ItineraryTracking.class</exclude>
                        <exclude>**/web/dto/PositionRequest.class</exclude>
                        <exclude>**/web/dto/PositionResponse.class</exclude>
                        <exclude>**/web/dto/StopView.class</exclude>
                        <exclude>**/web/dto/TripEventRequest.class</exclude>
                        <exclude>**/web/dto/TripEventResponse.class</exclude>
                        <exclude>**/web/dto/AssignDriverRequest.class</exclude>
                        <exclude>**/web/dto/DriverAssignmentResponse.class</exclude>
                        <exclude>**/web/dto/DriverTripView.class</exclude>
                        <exclude>**/web/dto/DriverLocationRequest.class</exclude>
                        <exclude>**/web/dto/LocationResult.class</exclude>
                        <exclude>**/web/dto/BatchLocationResponse.class</exclude>
                        <exclude>**/web/dto/TrackingStatusResponse.class</exclude>
                        <exclude>**/web/dto/StartTripRequest.class</exclude>
                        <exclude>**/web/dto/TripProgressResponse.class</exclude>
                        <exclude>**/web/dto/SosRequest.class</exclude>
                        <exclude>**/web/dto/ResolveAlertRequest.class</exclude>
                        <exclude>**/web/dto/TripAlertResponse.class</exclude>
                        <exclude>**/web/dto/EtaView.class</exclude>
                        <exclude>**/web/dto/FleetLiveResponse*.class</exclude>
                        <exclude>**/domain/BusPosition.class</exclude>
                        <exclude>**/domain/OutboxMessage.class</exclude>
                        <exclude>**/domain/TripEvent.class</exclude>
                        <exclude>**/common/events/ProcessedEvent.class</exclude>
                        <exclude>**/config/OpenApiConfig.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimo.lineas}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimo.ramas}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
